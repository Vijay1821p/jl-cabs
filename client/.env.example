# Leave empty during local development. The Vite server proxies /api to localhost:3001.
# On Vercel, set this to your Render URL with no trailing slash.
VITE_API_URL=

# Public Razorpay key only. Never put RAZORPAY_KEY_SECRET here.
VITE_RAZORPAY_KEY_ID=

# Browser key for Google Places Autocomplete. On Vercel, use this exact name
# (Sensitive is fine). Redeploy after saving it. Restrict the key by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
