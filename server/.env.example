PORT=3001

# Supabase → Project Settings → Database → Connection string → URI
# Use the Session pooler (port 5432) or Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# Razorpay → Account & Settings → API Keys (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Your Vercel site, no trailing slash. Separate several origins with commas.
CLIENT_ORIGIN=http://localhost:5173

# Optional: server-only Google key (IP restricted) for Routes API fallback if the browser cannot measure distance.
# GOOGLE_MAPS_API_KEY=
