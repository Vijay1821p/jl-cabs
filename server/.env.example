PORT=3001

# Supabase → Project Settings → Database → Connection string → URI
# Use the Session pooler (port 5432) or Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# Razorpay → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Your Vercel site, no trailing slash. Separate several origins with commas.
CLIENT_ORIGIN=http://localhost:5173
