{
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/trips/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(logo\\.png|logo\\.webp)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.jlcabs.com" }],
      "destination": "https://jlcabs.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://jayalakshmi-cabs-api.onrender.com/api/:path*" },
    { "source": "/((?!assets/|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
